{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'customer.gift_card.title' | t }}</title>
    {{ content_for_header }}
  </head>
  <body>
    <div id="QrCode"></div>
    <script>
      window.addEventListener('load', function() {
        new QRCode(document.getElementById('QrCode'), {
          text: '{{ gift_card.qr_identifier }}',
          width: 120,
          height: 120
        });
      });
    </script>
    <footer>
      {% if gift_card.pass_url %}
        <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'customer.gift_card.add_to_apple_wallet' | t }}"></a>
      {% endif %}
    </footer>
  </body>
</html>
